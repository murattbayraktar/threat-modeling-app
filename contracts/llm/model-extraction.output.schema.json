{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tm.bank.local/contracts/llm/model-extraction.output.schema.json",
  "title": "ModelExtractionOutput",
  "description": "LLM structured output: dokümandan mimari model çıkarımı. Tüm alanlar zorunludur (OpenAI strict mode uyumlu); bilinmeyen değerler null veya UNKNOWN olur.",
  "type": "object",
  "additionalProperties": false,
  "required": ["system", "components", "dataFlows", "missingInformation", "assumptions"],
  "properties": {
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "technology", "zone", "internetFacing", "authentication", "dataClasses", "description", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string", "description": "C1, C2, ... biçiminde" },
          "name": { "type": "string" },
          "type": { "$ref": "#/$defs/componentType" },
          "technology": { "type": ["string", "null"] },
          "zone": { "$ref": "#/$defs/zone" },
          "internetFacing": { "type": ["boolean", "null"] },
          "authentication": { "$ref": "#/$defs/authentication" },
          "dataClasses": { "type": "array", "items": { "$ref": "#/$defs/dataClass" } },
          "description": { "type": "string" },
          "evidence": { "$ref": "#/$defs/evidence" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "dataFlows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "target", "description", "protocol", "authentication", "encrypted", "dataClasses", "evidence", "confidence"],
        "properties": {
          "id": { "type": "string", "description": "F1, F2, ... biçiminde" },
          "source": { "type": "string", "description": "Kaynak bileşen id" },
          "target": { "type": "string", "description": "Hedef bileşen id" },
          "description": { "type": "string" },
          "protocol": { "type": ["string", "null"] },
          "authentication": { "$ref": "#/$defs/authentication" },
          "encrypted": { "type": ["boolean", "null"] },
          "dataClasses": { "type": "array", "items": { "$ref": "#/$defs/dataClass" } },
          "evidence": { "$ref": "#/$defs/evidence" },
          "confidence": { "$ref": "#/$defs/confidence" }
        }
      }
    },
    "missingInformation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "relatedElementId"],
        "properties": {
          "question": { "type": "string" },
          "relatedElementId": { "type": ["string", "null"] }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "componentType": {
      "type": "string",
      "enum": ["USER", "EXTERNAL_SYSTEM", "THIRD_PARTY_SYSTEM", "WEB_APP", "MOBILE_APP", "API_GATEWAY", "API", "SERVICE", "BATCH_JOB", "DATABASE", "FILE_STORAGE", "MESSAGE_QUEUE", "CORE_BANKING", "IDENTITY_PROVIDER", "OTHER"]
    },
    "zone": { "type": "string", "enum": ["INTERNET", "DMZ", "INTERNAL", "THIRD_PARTY", "UNKNOWN"] },
    "authentication": { "type": "string", "enum": ["NONE", "JWT", "OAUTH2", "MTLS", "SSO", "API_KEY", "BASIC", "SERVICE_ACCOUNT", "UNKNOWN"] },
    "dataClass": { "type": "string", "enum": ["PUBLIC", "INTERNAL", "PII", "CUSTOMER", "FINANCIAL", "CARD", "CREDENTIAL"] },
    "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["documentId", "section", "quote"],
      "properties": {
        "documentId": { "type": "string" },
        "section": { "type": "string" },
        "quote": { "type": "string" }
      }
    }
  }
}
